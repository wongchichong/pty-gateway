[Unit]
Description=PTY Gateway Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/projects/pty-gateway
Environment="NODE_ENV=production"
Environment="PTY_URL=http://localhost:3000"
EnvironmentFile=/etc/pty-gateway/config.env

# Auto-restart on failure
Restart=always
RestartSec=10

# Start limit (prevent restart loops)
StartLimitIntervalSec=60
StartLimitBurst=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pty-gateway

# Executable
ExecStart=/usr/bin/pnpm exec tsx src/index.ts \
  --telegram-token "${TELEGRAM_BOT_TOKEN}" \
  --telegram-users "${TELEGRAM_ALLOWED_USERS}"

# Graceful shutdown
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
