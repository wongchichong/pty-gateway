{
  "name": "pty-gateway",
  "version": "1.0.0",
  "description": "Gateway for PTY service - connect 22+ messaging platforms to PTY instances",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pty-gateway": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "discord.js": "^14.14.1",
    "grammy": "^1.26.1",
    "ws": "^8.16.0"
  },
  "peerDependencies": {
    "@line/bot-sdk": ">=7.0.0",
    "@slack/bolt": ">=3.0.0",
    "@whiskeysockets/baileys": ">=6.0.0",
    "irc-framework": ">=4.0.0",
    "matrix-js-sdk": ">=30.0.0",
    "nostr-tools": ">=1.0.0",
    "tmi.js": ">=1.8.0",
    "wechaty": ">=1.20.0"
  },
  "peerDependenciesMeta": {
    "@line/bot-sdk": { "optional": true },
    "@slack/bolt": { "optional": true },
    "@whiskeysockets/baileys": { "optional": true },
    "irc-framework": { "optional": true },
    "matrix-js-sdk": { "optional": true },
    "nostr-tools": { "optional": true },
    "tmi.js": { "optional": true },
    "wechaty": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/ws": "^8.5.10",
    "@vitest/coverage-v8": "^4.1.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.5"
  }
}
